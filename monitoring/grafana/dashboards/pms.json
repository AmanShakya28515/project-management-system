{
  "uid": "pms-monitoring",
  "title": "PMS monitoring",
  "tags": [
    "pms"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Uptime: is the app answering?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "App status (login page)",
      "description": "UP when the login page answers 200 within 5 s. Checked every 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A",
          "expr": "probe_success",
          "legendFormat": "login page"
        }
      ]
    },
    {
      "type": "state-timeline",
      "id": 3,
      "title": "Up / down over time",
      "description": "Green = up, red = down.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A",
          "expr": "probe_success",
          "legendFormat": "login page"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Login page response time",
      "description": "How long the login page takes to answer, as seen from the server.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds",
          "legendFormat": "total",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 5,
      "title": "Containers: the app (web) and its database (db)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "CPU (cores; each container is capped at 1.0)",
      "description": "CPU used by each container, in cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"pms-(web|db)-1\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Memory (dashed line = 512 MB limit)",
      "description": "Memory in use by each container, next to its limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"pms-(web|db)-1\"}",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "container_spec_memory_limit_bytes{name=~\"pms-(web|db)-1\"}",
          "legendFormat": "{{name}} limit",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Server: the whole VPS (all sites together)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "CPU used",
      "description": "Share of all CPU cores in use on the server.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Memory used",
      "description": "Share of the server's memory in use.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "memory",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Disk used (/)",
      "description": "Share of the root disk in use.",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
          "legendFormat": "/",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Load average",
      "description": "Processes waiting for CPU. Compare with the number of cores (2).",
      "datasource": {
        "type": "prometheus",
        "uid": "pms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "node_load1",
          "legendFormat": "1 min",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "node_load5",
          "legendFormat": "5 min",
          "datasource": {
            "type": "prometheus",
            "uid": "pms-prometheus"
          },
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 13,
      "title": "Logs: app and database",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "type": "logs",
      "id": 14,
      "title": "Logs ($service)",
      "description": "Container logs of project pms. Use the search box at the top of Explore for more.",
      "datasource": {
        "type": "loki",
        "uid": "pms-loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "pms-loki"
          },
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ \"(?i)$search\""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "service",
        "label": "Service",
        "query": "web,db",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search logs",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
